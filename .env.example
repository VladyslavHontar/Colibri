# Nothing here is required — `docker compose up -d --build` works as-is (STUN by
# default, auth token auto-generated). Copy to .env only to override a default.
#
# ── Optional (leave unset for a NAT home server) ──────────────────────────────
# Host has a real public IP on its interface? Set it to skip STUN:
# PUBLIC_IP=203.0.113.10
# Pin the gRPC auth token instead of letting the container generate one:
# AUTH_TOKEN=
# Override the RPC used for stake / leader schedule:
# SOLANA_RPC=https://api.mainnet-beta.solana.com
# Backfill depth from tip on first subscribe:
# DEPTH=500
