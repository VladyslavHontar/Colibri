# Copy to .env. The only required value: a GitHub token that can read the
# private Deshreder repo (the build fetches it as a git dependency).
# Create one at https://github.com/settings/tokens (classic: `repo` scope,
# or fine-grained: read access to the Deshreder repo).
GITHUB_TOKEN=

# ── Optional (sane defaults, leave unset for a NAT home server) ────────────────
# Host has a real public IP on its interface? Set it to skip STUN:
# PUBLIC_IP=203.0.113.10
# Pin the gRPC auth token instead of letting the container generate one:
# AUTH_TOKEN=
# Override the RPC used for stake / leader schedule:
# SOLANA_RPC=https://api.mainnet-beta.solana.com
# Backfill depth from tip on first subscribe:
# DEPTH=500
